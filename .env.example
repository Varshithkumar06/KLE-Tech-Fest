# Estimo - Environment Configuration
# ===================================
# Copy this file to .env and insert your API credentials.

# Gemini Multimodal Vision API Key (Required for architecture diagram analysis)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# NVIDIA Nemotron Inference API Key (Optional fallback: Gemini)
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Web Search APIs (Used by hardware pricing agents)
TAVILY_API_KEY=your_tavily_api_key_here
SERPAPI_KEY=your_serpapi_key_here

# Server Port
PORT=5002
